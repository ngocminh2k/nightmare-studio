# Optional live-provider credentials. Keep this file as placeholders only.
NIGHTMARE_OPENAI_API_KEY=
NIGHTMARE_YOUTUBE_CLIENT_ID=
NIGHTMARE_YOUTUBE_CLIENT_SECRET=

# Legacy Python-compatible 9Router LLM provider. It defaults to this local endpoint.
NIGHTMARE_LLM_MODE=router
NIGHTMARE_LLM_BASE_URL=http://localhost:20128/v1
# Leave blank to use the active local 9Router key. It is read at runtime only.
NIGHTMARE_LLM_API_KEY=
NIGHTMARE_LLM_SEND_AUTH=true
NIGHTMARE_LLM_MODEL=mrkane
NIGHTMARE_LLM_FALLBACK_MODEL=gemini/gemini-3-flash-preview
NIGHTMARE_LLM_TIMEOUT_SECONDS=600
NIGHTMARE_LLM_MAX_RETRIES=3
NIGHTMARE_LLM_RETRY_DELAY_SECONDS=15

# Media generation is disabled until a real CDP workspace is explicitly configured.
# `google_flow_cdp` controls an authenticated Google Flow tab and always switches
# between Image and Video mode before it submits a prompt. No cookies or passwords
# live in this project; the adapter uses the Chrome session through CDP.
NIGHTMARE_MEDIA_MODE=not_configured
NIGHTMARE_CANVAS_CDP_URL=http://127.0.0.1:9222
# For Google Flow, set both URLs to the same Flow project workspace.
NIGHTMARE_CANVAS_IMAGE_URL=
NIGHTMARE_CANVAS_VIDEO_URL=
# Required for `google_flow_cdp`: absolute path to the single-frame Mr Kane reference.
# Generate this once from the approved source sheet (`F:\truyen_ma\mrkane.jpg`) to prevent Flow from copying its four-panel layout.
NIGHTMARE_FLOW_CHARACTER_REFERENCE_PATH=
NIGHTMARE_CANVAS_IMAGE_PROMPT_SELECTOR=textarea
NIGHTMARE_CANVAS_IMAGE_SUBMIT_SELECTOR=button[type='submit']
NIGHTMARE_CANVAS_IMAGE_RESULT_SELECTOR=img
NIGHTMARE_CANVAS_VIDEO_PROMPT_SELECTOR=textarea
NIGHTMARE_CANVAS_VIDEO_SUBMIT_SELECTOR=button[type='submit']
NIGHTMARE_CANVAS_VIDEO_RESULT_SELECTOR=video
NIGHTMARE_CANVAS_VIDEO_IMAGE_INPUT_SELECTOR=input[type='file']
NIGHTMARE_CANVAS_TIMEOUT_SECONDS=180

# Optional absolute or relative SQLite database path. Defaults to data/studio.db.
NIGHTMARE_STUDIO_DB=
