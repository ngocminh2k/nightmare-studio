# Optional live-provider credentials. Keep this file as placeholders only.
NIGHTMARE_OPENAI_API_KEY=
NIGHTMARE_YOUTUBE_CLIENT_ID=
NIGHTMARE_YOUTUBE_CLIENT_SECRET=

# Legacy Python-compatible 9Router LLM provider. It defaults to this local endpoint.
NIGHTMARE_LLM_MODE=router
NIGHTMARE_LLM_BASE_URL=http://localhost:20128/v1
# Leave blank to use the active local 9Router key. It is read at runtime only.
NIGHTMARE_LLM_API_KEY=
NIGHTMARE_LLM_SEND_AUTH=true
NIGHTMARE_LLM_MODEL=mrkane
NIGHTMARE_LLM_FALLBACK_MODEL=gemini/gemini-3-flash-preview
NIGHTMARE_LLM_TIMEOUT_SECONDS=600
NIGHTMARE_LLM_MAX_RETRIES=3
NIGHTMARE_LLM_RETRY_DELAY_SECONDS=15

# Media generation mode.
# `flowkit`        — recommended. Calls github.com/crisng95/flowkit running at localhost:8100.
#                   Requires: flowkit agent running (`python -m agent.main`), Chrome extension
#                   loaded, one signed-in flow.google.com tab open, FLOW_PROJECT_ID pinned.
# `google_flow_cdp` — legacy CDP approach (deprecated, kept for fallback)
# `google_veo`     — direct Veo REST API (needs GOOGLE_API_KEY)
# `kira_api`       — Kira.ai REST API
# `not_configured` — fails closed (default/safe)
NIGHTMARE_MEDIA_MODE=not_configured

# ── Flowkit (NIGHTMARE_MEDIA_MODE=flowkit) ──────────────────────────────────
# Single account (1 flowkit instance):
NIGHTMARE_FLOWKIT_URL=http://127.0.0.1:8100
NIGHTMARE_FLOWKIT_PROJECT=<uuid từ flow.google.com URL>
NIGHTMARE_FLOWKIT_MODEL_VIDEO=omni_flash
NIGHTMARE_FLOWKIT_MODEL_IMAGE=NANO_BANANA_2
# Omni version: 1.1 (default, keys abra_*) | 1.2 (macaron_cookie, 3-15s)
# 1.2 requires flowkit PR #85 merged. Duration cap still: 10s max.
NIGHTMARE_FLOWKIT_OMNI_VERSION=1.1

# Multi-account — KHÔNG dùng. Kiến trúc hiện tại: 1 flowkit duy nhất, đổi account tuần tự
# bằng `scripts/switch-account.ps1`. `app/pool_manager.py` đã bị xoá.
NIGHTMARE_FLOWKIT_POOL_URL=
FLOW_ACCOUNTS=8100:

# ── Legacy CDP settings (NIGHTMARE_MEDIA_MODE=google_flow_cdp) ─────────────
NIGHTMARE_CANVAS_CDP_URL=http://127.0.0.1:9222
# For Google Flow, set both URLs to the same Flow project workspace.
NIGHTMARE_CANVAS_IMAGE_URL=
NIGHTMARE_CANVAS_VIDEO_URL=
# Required for `google_flow_cdp`: absolute path to the single-frame Mr Kane reference.
# Generate this once from the approved source sheet (`F:\truyen_ma\mrkane.jpg`) to prevent Flow from copying its four-panel layout.
NIGHTMARE_FLOW_CHARACTER_REFERENCE_PATH=
# Flow runner options ('auto', 'subprocess'/'ts', or 'python')
NIGHTMARE_FLOW_RUNNER=auto
NIGHTMARE_FLOW_RUNNER_PATH=
# Flow models and modes
NIGHTMARE_FLOW_MODEL_IMAGE=Nano Banana 2
NIGHTMARE_FLOW_MODEL_VIDEO=Omni 1.1 Flash
NIGHTMARE_FLOW_VIDEO_RESOLUTION=360p
NIGHTMARE_FLOW_ASPECT_RATIO=16:9
NIGHTMARE_FLOW_VIDEO_INPUT_MODE=ingredients
NIGHTMARE_FLOW_VIDEO_DURATION=6
NIGHTMARE_CANVAS_IMAGE_PROMPT_SELECTOR=textarea
NIGHTMARE_CANVAS_IMAGE_SUBMIT_SELECTOR=button[type='submit']
NIGHTMARE_CANVAS_IMAGE_RESULT_SELECTOR=img
NIGHTMARE_CANVAS_VIDEO_PROMPT_SELECTOR=textarea
NIGHTMARE_CANVAS_VIDEO_SUBMIT_SELECTOR=button[type='submit']
NIGHTMARE_CANVAS_VIDEO_RESULT_SELECTOR=video
NIGHTMARE_CANVAS_VIDEO_IMAGE_INPUT_SELECTOR=input[type='file']
NIGHTMARE_CANVAS_TIMEOUT_SECONDS=180
# Chrome CDP Auto-Launch (defaults to true for localhost endpoints; auto-finds chrome.exe and temp_chrome_profile)
NIGHTMARE_AUTO_LAUNCH_CDP=true
NIGHTMARE_CHROME_PATH=
NIGHTMARE_CHROME_USER_DATA_DIR=

# Optional absolute or relative SQLite database path. Defaults to data/studio.db.
NIGHTMARE_STUDIO_DB=

# ── Voiceover (VoiceStudio / OmniVoice local) ─────────────────────────────────
# PHẢI là voice_studio. Nếu để trống, pipeline fallback sang pink noise và master ra im lặng.
NIGHTMARE_AUDIO_MODE=voice_studio
NIGHTMARE_VOICE_STUDIO_URL=http://127.0.0.1:3900
# Profile giọng trong VoiceStudio (mrkane)
NIGHTMARE_AUDIO_VOICE=mrkane
NIGHTMARE_AUDIO_MODEL=omnivoice
NIGHTMARE_AUDIO_FORMAT=mp3
NIGHTMARE_AUDIO_TIMEOUT_SECONDS=900
# Chất lượng diffusion (32 = preset quality), bám instruct, tiếng Anh, slow-burn 0.88
NIGHTMARE_AUDIO_NUM_STEP=32
NIGHTMARE_AUDIO_GUIDANCE_SCALE=2.0
NIGHTMARE_AUDIO_LANGUAGE=en
NIGHTMARE_AUDIO_SPEED=0.88

# Episode đang xử lý — script production dùng làm default khi không truyền --episode-id
NIGHTMARE_EPISODE_ID=
